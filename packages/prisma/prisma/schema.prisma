generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlayerRole {
  BAT
  BOWL
  ALL_ROUNDER
  WICKET_KEEPER
}

model Player {
  id         String     @id @default(uuid())
  name       String
  role       PlayerRole
  country    String?
  basePrice  Decimal    @db.Decimal(12, 2)
  isOverseas Boolean    @default(false)
  createdAt  DateTime   @default(now())
}
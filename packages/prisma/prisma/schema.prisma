generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum PlayerRole {
  BAT
  BOWL
  ALL_ROUNDER
  WICKET_KEEPER
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuctionStatus {
  DRAFT
  LIVE
  PAUSED
  COMPLETED
}

enum MatchFormat {
  T20
  T10
  TENNIS_BALL
}

enum AuctionLotStatus {
  PENDING
  IN_PROGRESS
  SOLD
  UNSOLD
}

// ============================================================
// MULTI-TENANCY
// ============================================================

// The tenant root. Every resource belongs to one Organization.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // URL-safe identifier e.g. "mumbai-league"
  createdAt DateTime @default(now())

  members  UserProfile[]
  teams    Team[]
  players  Player[]
  auctions Auction[]
}

model UserProfile {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?
  displayName    String?
  avatarUrl      String?
  organizationId String?
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAuctions Auction[]

  @@index([organizationId])
}

// ============================================================
// PLAYER / TEAM
// ============================================================

// organizationId = null  →  global IPL seed data (shared across all orgs)
// organizationId = <id>  →  custom player created by that org
model Player {
  id             String       @id @default(uuid())
  name           String
  role           PlayerRole
  country        String?
  basePrice      Decimal      @db.Decimal(12, 2)
  isOverseas     Boolean      @default(false)
  avatarUrl      String?
  organizationId String?
  createdAt      DateTime     @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auctionLots  AuctionLot[]

  @@index([organizationId])
}

// organizationId = null  →  global IPL teams (seed data)
// organizationId = <id>  →  custom team created by that org
model Team {
  id             String   @id @default(uuid())
  name           String
  shortName      String
  primaryColor   String?
  logoUrl        String?
  organizationId String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auctionTeams AuctionTeam[]

  // shortName unique per org (null org = global seed, unique globally)
  @@unique([organizationId, shortName])
  @@index([organizationId])
}

// ============================================================
// AUCTION
// ============================================================

model Auction {
  id                  String        @id @default(uuid())
  name                String
  status              AuctionStatus @default(DRAFT)
  format              MatchFormat
  purseSizePerTeam    Decimal       @db.Decimal(14, 2)
  maxSquadSize        Int
  maxOverseasPerSquad Int
  organizationId      String
  createdById         String
  createdAt           DateTime      @default(now())
  startedAt           DateTime?
  completedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    UserProfile  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  auctionTeams AuctionTeam[]
  auctionLots  AuctionLot[]

  @@index([organizationId])
}

model AuctionTeam {
  id               String  @id @default(uuid())
  auctionId        String
  teamId           String
  remainingPurse   Decimal @db.Decimal(14, 2)
  playersAcquired  Int     @default(0)
  overseasAcquired Int     @default(0)

  auction  Auction    @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  team     Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  bids     Bid[]
  wonLots  AuctionLot[] @relation("LotSoldToTeam")

  @@unique([auctionId, teamId])
  @@index([auctionId])
}

model AuctionLot {
  id           String           @id @default(uuid())
  auctionId    String
  playerId     String
  lotNumber    Int
  status       AuctionLotStatus @default(PENDING)
  soldToTeamId String?
  soldPrice    Decimal?         @db.Decimal(14, 2)
  createdAt    DateTime         @default(now())

  auction    Auction      @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  player     Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)
  soldToTeam AuctionTeam? @relation("LotSoldToTeam", fields: [soldToTeamId], references: [id], onDelete: SetNull)
  bids       Bid[]

  @@unique([auctionId, playerId])
  @@unique([auctionId, lotNumber])
  @@index([auctionId, status])
}

model Bid {
  id            String   @id @default(uuid())
  auctionLotId  String
  auctionTeamId String
  amount        Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  auctionLot  AuctionLot  @relation(fields: [auctionLotId], references: [id], onDelete: Cascade)
  auctionTeam AuctionTeam @relation(fields: [auctionTeamId], references: [id], onDelete: Cascade)

  @@index([auctionLotId, createdAt])
  @@index([auctionTeamId])
}
